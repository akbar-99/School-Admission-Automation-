; Sweep Reversal 3-Bar EA v3
; Preset for XAUUSD with a normal spread of 16 points (EA v5)
; Load in MT5:  attach EA -> Inputs tab -> Load -> pick this file
; Start with InpEnableTrading = false and watch the markings first.

InpMagic=770312
InpComment=Sweep3
InpEnableTrading=false
InpAllowBuy=true
InpAllowSell=true
InpStartHour=0
InpEndHour=24
InpMaxTradesPerDay=5
InpOnePositionOnly=true

InpBar3MinBody=0.5
InpBar1MinBody=0.55
InpBar2MaxBody=0.5
InpMinSweepAtr=0.25
InpBar1MustEngulf=true
InpBar1BodyRatio=0.9
InpBar2InsideRange=false
InpMinPatternAtr=0.8

InpUseEmaFilter=false
InpEmaPeriod=200
InpTradeWithEma=true
InpUseAtrFilter=true
InpAtrPeriod=14
InpAtrMinRatio=0.6
InpAtrMaxRatio=2.5
InpMaxSpreadPoints=28

InpUseRegime=true
InpErTrend=0.35
InpAdxTrend=25.0
InpTrendBars=50
InpAllowCounterTrend=false
InpRangeNeedsEdge=true

InpUseAdxFilter=true
InpAdxPeriod=14
InpAdxMin=18.0
InpUseEfficiency=true
InpErBars=20
InpErMin=0.28
InpUseRangePos=true
InpRangePosBars=50
InpRangePosPct=0.35
InpUseTwoSideSweep=true
InpTwoSideBars=20
InpUseRoomCheck=true
InpRoomBars=50
InpRoomMult=1.0
InpRoomClipTp=false

InpEntryMode=0
InpRetestLevel=0
InpEntryBufferAtr=0.05
InpPendingExpiryBars=10

InpUseSpreadAdjust=true
InpSpreadEntryMult=1.5
InpSpreadSlMult=1.0
InpFixedSpreadPoints=0
InpMinSpreadPoints=16
InpMaxSpreadAtrPct=0

InpSlMode=0
InpSlBufferAtr=0.2
InpSlAtrMult=1.5
InpRiskReward=2.0
InpRiskPercent=0.5
InpFixedLot=0.0
InpDailyMaxLossPct=3.0
InpDailyProfitPct=5.0

InpUseBreakEven=true
InpBeTriggerR=1.0
InpBeLockPoints=20
InpUseTrailing=true
InpTrailAtrMult=1.5
InpUsePartial=true
InpPartialAtR=1.0
InpPartialPercent=50.0
InpTimeExitBars=0

InpMarkPatterns=true
InpScanBars=1500
InpMaxMarkings=200
InpMarkBlocked=true
InpDrawBox=true
InpDrawNumbers=true
InpDrawLevelLines=true
InpDrawSweepMark=true
InpDrawEntryLines=true
InpDrawText=true
InpBoxWidth=1
InpTextSize=8

InpShowPanel=true
InpPanelX=12
InpPanelY=22
InpFontSize=9
